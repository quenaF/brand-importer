{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brand-importer.dev/schemas/brand-pack.schema.json",
  "title": "Brand Pack",
  "description": "Framework-neutral, evidence-backed brand identity package produced by Brand Importer.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "brand", "sources", "identity", "voice", "experience", "evidence"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "brand": { "$ref": "#/$defs/brand" },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
    "identity": { "$ref": "#/$defs/identity" },
    "voice": { "$ref": "#/$defs/voice" },
    "experience": { "$ref": "#/$defs/experience" },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/asset" }, "default": [] },
    "evidence": { "$ref": "evidence.schema.json" },
    "unknowns": { "type": "array", "items": { "$ref": "#/$defs/unknown" }, "default": [] },
    "ownerReview": { "$ref": "#/$defs/ownerReview" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "evidenceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "evidencedString": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "evidenceIds"],
      "properties": {
        "value": { "type": "string", "minLength": 1 },
        "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "slug"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "legalName": { "type": "string" },
        "website": { "type": "string", "format": "uri" },
        "tagline": { "$ref": "#/$defs/evidencedString" },
        "summary": { "$ref": "#/$defs/evidencedString" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "location", "authorization"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["website", "brand-guide", "logo", "stylesheet", "design-tokens", "manual-input", "other"] },
        "location": { "type": "string", "minLength": 1 },
        "authorization": { "enum": ["owner-provided", "owner-authorized", "public-reference", "unknown"] },
        "capturedAt": { "type": "string", "format": "date-time" }
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["colors", "typography"],
      "properties": {
        "colors": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/color" } },
        "typography": { "$ref": "#/$defs/typography" },
        "spacing": { "$ref": "#/$defs/tokenScale" },
        "radii": { "$ref": "#/$defs/tokenScale" },
        "shadows": { "$ref": "#/$defs/tokenScale" },
        "motion": { "$ref": "#/$defs/guidance" },
        "imagery": { "$ref": "#/$defs/guidance" },
        "iconography": { "$ref": "#/$defs/guidance" }
      }
    },
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value", "role", "evidenceIds"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$" },
        "role": { "enum": ["primary", "secondary", "accent", "surface", "text", "border", "success", "warning", "error", "info", "other"] },
        "usage": { "type": "array", "items": { "type": "string" } },
        "avoid": { "type": "array", "items": { "type": "string" } },
        "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "typography": {
      "type": "object",
      "additionalProperties": false,
      "required": ["families", "roles"],
      "properties": {
        "families": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fontFamily" } },
        "roles": { "type": "object", "minProperties": 1, "additionalProperties": { "type": "string" } }
      }
    },
    "fontFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "fallbacks", "evidenceIds"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "fallbacks": { "type": "array", "items": { "type": "string" } },
        "source": { "type": "string" },
        "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "tokenScale": {
      "type": "object",
      "additionalProperties": { "oneOf": [{ "type": "string" }, { "type": "number" }] }
    },
    "guidance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prefer": { "type": "array", "items": { "type": "string" } },
        "avoid": { "type": "array", "items": { "type": "string" } },
        "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "voice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qualities", "principles"],
      "properties": {
        "qualities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidencedString" } },
        "principles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidencedString" } },
        "preferredVocabulary": { "type": "array", "items": { "$ref": "#/$defs/evidencedString" } },
        "avoidVocabulary": { "type": "array", "items": { "$ref": "#/$defs/evidencedString" } },
        "ctaPattern": { "$ref": "#/$defs/evidencedString" },
        "examples": { "type": "array", "items": { "type": "string" } }
      }
    },
    "experience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brandPromise", "desiredOutcomes", "trustPrinciples"],
      "properties": {
        "brandPromise": { "$ref": "#/$defs/evidencedString" },
        "desiredOutcomes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidencedString" } },
        "trustPrinciples": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/evidencedString" } },
        "interactionPrinciples": { "type": "array", "items": { "$ref": "#/$defs/evidencedString" } },
        "recoveryPrinciples": { "type": "array", "items": { "$ref": "#/$defs/evidencedString" } }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "location", "usage", "evidenceIds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["logo", "logo-mark", "wordmark", "favicon", "photography", "illustration", "icon", "font", "other"] },
        "location": { "type": "string" },
        "usage": { "type": "array", "items": { "type": "string" } },
        "restrictions": { "type": "array", "items": { "type": "string" } },
        "evidenceIds": { "$ref": "#/$defs/evidenceIds" }
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "impact"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "question": { "type": "string", "minLength": 1 },
        "impact": { "enum": ["blocking", "material", "minor"] },
        "recommendedAction": { "type": "string" }
      }
    },
    "ownerReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["not-started", "in-progress", "confirmed", "confirmed-with-corrections"] },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "reviewer": { "type": "string" },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
