{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brand-importer.dev/schemas/import-session.schema.json",
  "title": "Ephemeral Brand Import Session",
  "type": "object",
  "additionalProperties": false,
  "required": ["sessionVersion", "sessionId", "requestId", "status", "createdAt", "updatedAt", "retention", "contracts", "outputs"],
  "properties": {
    "sessionVersion": { "const": "1.0.0" },
    "sessionId": { "type": "string", "minLength": 1 },
    "requestId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["created", "running", "awaiting-review", "accepted", "cancelled", "failed", "exported", "disposed"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": ["string", "null"], "format": "date-time" },
    "disposedAt": { "type": ["string", "null"], "format": "date-time" },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "disposeAfterExport", "persistentOrganizationMemory"],
      "properties": {
        "mode": { "const": "session-only" },
        "disposeAfterExport": { "const": true },
        "persistentOrganizationMemory": { "const": false }
      }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtimeBrand", "experienceProfile", "domainAdapter", "ownerDecisions", "progressEvents", "importReport"],
      "properties": {
        "runtimeBrand": { "const": "1.0.0" },
        "experienceProfile": { "const": "1.0.0" },
        "domainAdapter": { "const": "1.0.0" },
        "ownerDecisions": { "const": "1.0.0" },
        "progressEvents": { "const": "1.0.0" },
        "importReport": { "const": "1.0.0" }
      }
    },
    "outputs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "failure": { "type": ["object", "null"], "additionalProperties": false, "properties": { "code": { "type": "string" }, "message": { "type": "string" } } }
  }
}
