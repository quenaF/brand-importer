{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brand-importer.dev/schemas/normalized-candidates.schema.json",
  "title": "Normalized Brand Candidates",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "status", "generatedAt", "colors", "typography", "assets", "imagery", "unknowns"],
  "properties": {
    "schemaVersion": { "const": "0.1.0" },
    "requestId": { "type": "string", "minLength": 1 },
    "status": { "const": "provisional" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "colors": { "type": "array", "items": { "$ref": "#/$defs/colorCandidate" } },
    "typography": { "type": "array", "items": { "$ref": "#/$defs/fontCandidate" } },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/assetCandidate" } },
    "imagery": { "type": "array", "items": { "$ref": "#/$defs/imageryCandidate" } },
    "unknowns": { "type": "array", "items": { "$ref": "#/$defs/unknown" } },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rawColorCount": { "type": "integer", "minimum": 0 },
        "normalizedColorCount": { "type": "integer", "minimum": 0 },
        "rawFontCount": { "type": "integer", "minimum": 0 },
        "normalizedFontCount": { "type": "integer", "minimum": 0 },
        "logoCandidateCount": { "type": "integer", "minimum": 0 },
        "rawImageCount": { "type": "integer", "minimum": 0 },
        "imageryCandidateCount": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "colorCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "value", "candidateRoles", "score", "status", "requiresOwnerReview", "evidenceIds", "rationale", "occurrences"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" },
        "value": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}(?:[0-9a-fA-F]{2})?$" },
        "candidateRoles": { "type": "array", "items": { "enum": ["primary", "secondary", "accent", "surface", "background", "text", "border", "semantic", "unknown"] }, "minItems": 1, "uniqueItems": true },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "status": { "const": "derived" },
        "requiresOwnerReview": { "const": true },
        "evidenceIds": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "rationale": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "occurrences": { "type": "integer", "minimum": 1 },
        "sources": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "fontCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "family", "candidateRoles", "score", "status", "requiresOwnerReview", "evidenceIds", "rationale", "occurrences"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" },
        "family": { "type": "string", "minLength": 1 },
        "candidateRoles": { "type": "array", "items": { "enum": ["display", "heading", "body", "navigation", "label", "fallback", "icon", "unknown"] }, "minItems": 1, "uniqueItems": true },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "status": { "const": "derived" },
        "requiresOwnerReview": { "const": true },
        "evidenceIds": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "rationale": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "occurrences": { "type": "integer", "minimum": 1 },
        "excludedFromBrandTypography": { "type": "boolean" }
      }
    },
    "assetCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "location", "candidateRoles", "score", "status", "requiresOwnerReview", "evidenceIds", "rationale"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" },
        "location": { "type": "string", "minLength": 1 },
        "candidateRoles": { "type": "array", "items": { "enum": ["primary-logo", "secondary-logo", "wordmark", "mark", "unknown"] }, "minItems": 1, "uniqueItems": true },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "status": { "const": "derived" },
        "requiresOwnerReview": { "const": true },
        "evidenceIds": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "rationale": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "alt": { "type": "string" }
      }
    },
    "imageryCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "location", "sourcePages", "discoveryMethod", "categories", "candidateRoles", "score", "brandRepresentativeness", "qualitySuitability", "diversityValue", "utility", "status", "requiresOwnerReview", "evidenceIds", "rationale", "orientation", "people", "peopleLikely", "rightsStatus", "selectionStatus", "approvalStatus", "safeguards"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" },
        "location": { "type": "string", "minLength": 1 },
        "sourcePages": { "type": "array", "items": { "type": "string", "format": "uri" }, "minItems": 1, "uniqueItems": true },
        "discoveryMethod": { "enum": ["img", "picture-or-img", "open-graph", "css-background", "other"] },
        "categories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/imageCategory" } },
        "candidateRoles": { "type": "array", "items": { "enum": ["hero", "section-banner", "experience-card", "product-card", "brand-atmosphere", "content-support", "background-texture", "unknown"] }, "minItems": 1, "uniqueItems": true },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "brandRepresentativeness": { "type": "number", "minimum": 0, "maximum": 1 },
        "qualitySuitability": { "type": "number", "minimum": 0, "maximum": 1 },
        "diversityValue": { "type": "number", "minimum": 0, "maximum": 1 },
        "utility": { "type": "boolean" },
        "utilityReason": { "type": ["string", "null"] },
        "status": { "const": "derived" },
        "requiresOwnerReview": { "const": true },
        "evidenceIds": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "rationale": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "alt": { "type": "string" },
        "parentRegion": { "type": "string" },
        "width": { "type": ["integer", "null"], "minimum": 1 },
        "height": { "type": ["integer", "null"], "minimum": 1 },
        "orientation": { "enum": ["landscape", "portrait", "square", "unknown"] },
        "people": {
          "type": "object",
          "additionalProperties": false,
          "required": ["presentLikely", "minorsLikely", "identifiableLikely"],
          "properties": {
            "presentLikely": { "type": "boolean" },
            "minorsLikely": { "type": "boolean" },
            "identifiableLikely": { "type": "boolean" }
          }
        },
        "peopleLikely": { "type": "boolean" },
        "rightsStatus": { "enum": ["owner-approved", "owner-authorized-source", "unknown", "restricted"] },
        "selectionStatus": { "enum": ["recommended", "supporting", "excluded"] },
        "approvalStatus": { "enum": ["approved", "rejected", "held", "unreviewed"] },
        "safeguards": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "imageCategory": {
      "enum": ["people", "participants", "staff", "team", "activity", "instructional", "program-representation", "community", "event", "environment", "location", "facility", "product", "storefront-product", "editorial", "campaign", "illustration", "texture", "brand-atmosphere"]
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "impact"],
      "properties": {
        "id": { "type": "string" },
        "question": { "type": "string", "minLength": 1 },
        "impact": { "enum": ["blocking", "material", "minor"] },
        "recommendedAction": { "type": "string" },
        "references": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    }
  }
}
