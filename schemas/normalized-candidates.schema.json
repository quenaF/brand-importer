{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brand-importer.dev/schemas/normalized-candidates.schema.json",
  "title": "Normalized Brand Candidates",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "requestId", "status", "generatedAt", "colors", "typography", "assets", "imagery", "unknowns", "summary"],
  "properties": {
    "schemaVersion": { "enum": ["0.1.0", "1.0.0"] },
    "requestId": { "type": "string", "minLength": 1 },
    "status": { "const": "provisional" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "colors": { "type": "array", "items": { "$ref": "#/$defs/colorCandidate" } },
    "typography": { "type": "array", "items": { "$ref": "#/$defs/fontCandidate" } },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/assetCandidate" } },
    "imagery": { "type": "array", "items": { "$ref": "#/$defs/imageryCandidate" } },
    "unknowns": { "type": "array", "items": { "$ref": "#/$defs/unknown" } },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rawColorCount", "normalizedColorCount", "rawFontCount", "normalizedFontCount", "logoCandidateCount", "rawImageCount", "imageryCandidateCount"],
      "properties": {
        "rawColorCount": { "type": "integer", "minimum": 0 },
        "normalizedColorCount": { "type": "integer", "minimum": 0 },
        "rawFontCount": { "type": "integer", "minimum": 0 },
        "normalizedFontCount": { "type": "integer", "minimum": 0 },
        "logoCandidateCount": { "type": "integer", "minimum": 0 },
        "rawImageCount": { "type": "integer", "minimum": 0 },
        "imageryCandidateCount": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "candidateCore": {
      "type": "object",
      "required": ["id", "score", "status", "requiresOwnerReview", "evidenceIds", "rationale"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "status": { "const": "derived" },
        "requiresOwnerReview": { "const": true },
        "evidenceIds": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "rationale": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
      }
    },
    "colorCandidate": {
      "allOf": [
        { "$ref": "#/$defs/candidateCore" },
        { "type": "object", "required": ["value", "candidateRoles", "occurrences"], "properties": { "value": { "type": "string" }, "candidateRoles": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true }, "occurrences": { "type": "integer", "minimum": 1 }, "sources": { "type": "array", "items": { "type": "string" }, "uniqueItems": true } } }
      ],
      "unevaluatedProperties": false
    },
    "fontCandidate": {
      "allOf": [
        { "$ref": "#/$defs/candidateCore" },
        { "type": "object", "required": ["family", "candidateRoles", "occurrences"], "properties": { "family": { "type": "string", "minLength": 1 }, "candidateRoles": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true }, "occurrences": { "type": "integer", "minimum": 1 }, "excludedFromBrandTypography": { "type": "boolean" } } }
      ],
      "unevaluatedProperties": false
    },
    "assetCandidate": {
      "allOf": [
        { "$ref": "#/$defs/candidateCore" },
        { "type": "object", "required": ["location", "candidateRoles"], "properties": { "location": { "type": "string", "minLength": 1 }, "candidateRoles": { "type": "array", "items": { "enum": ["primary-logo", "secondary-logo", "wordmark", "mark", "unknown"] }, "minItems": 1, "uniqueItems": true }, "alt": { "type": "string" }, "discoveryMethod": { "type": "string" }, "sourcePage": { "type": ["string", "null"] }, "inlineSvg": { "type": "boolean" }, "width": { "type": ["integer", "null"], "minimum": 1 }, "height": { "type": ["integer", "null"], "minimum": 1 } } }
      ],
      "unevaluatedProperties": false
    },
    "imageryCandidate": {
      "allOf": [
        { "$ref": "#/$defs/candidateCore" },
        { "type": "object", "required": ["location", "sourcePages", "discoveryMethod", "categories", "candidateRoles", "brandRepresentativeness", "qualitySuitability", "heroSuitability", "activityRelevance", "diversityValue", "productOnly", "utility", "orientation", "people", "peopleLikely", "rightsStatus", "selectionStatus", "approvalStatus", "safeguards"], "properties": {
          "location": { "type": "string", "minLength": 1 },
          "sourcePages": { "type": "array", "items": { "type": "string", "format": "uri" }, "minItems": 1, "uniqueItems": true },
          "discoveryMethod": { "type": "string" },
          "categories": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/imageCategory" } },
          "candidateRoles": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
          "brandRepresentativeness": { "type": "number", "minimum": 0, "maximum": 1 },
          "qualitySuitability": { "type": "number", "minimum": 0, "maximum": 1 },
          "heroSuitability": { "type": "number", "minimum": 0, "maximum": 1 },
          "activityRelevance": { "type": "number", "minimum": 0, "maximum": 1 },
          "diversityValue": { "type": "number", "minimum": 0, "maximum": 1 },
          "productOnly": { "type": "boolean" },
          "utility": { "type": "boolean" },
          "utilityReason": { "type": ["string", "null"] },
          "alt": { "type": "string" },
          "parentRegion": { "type": "string" },
          "width": { "type": ["integer", "null"], "minimum": 1 },
          "height": { "type": ["integer", "null"], "minimum": 1 },
          "orientation": { "enum": ["landscape", "portrait", "square", "unknown"] },
          "people": { "type": "object", "additionalProperties": false, "required": ["presentLikely", "minorsLikely", "identifiableLikely"], "properties": { "presentLikely": { "type": "boolean" }, "minorsLikely": { "type": "boolean" }, "identifiableLikely": { "type": "boolean" } } },
          "peopleLikely": { "type": "boolean" },
          "rightsStatus": { "enum": ["owner-approved", "owner-authorized-source", "unknown", "restricted"] },
          "selectionStatus": { "enum": ["recommended", "supporting", "excluded"] },
          "approvalStatus": { "enum": ["approved", "rejected", "held", "unreviewed"] },
          "safeguards": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        } }
      ],
      "unevaluatedProperties": false
    },
    "imageCategory": { "enum": ["people", "participants", "staff", "team", "activity", "instructional", "program-representation", "community", "event", "environment", "location", "facility", "product", "storefront-product", "editorial", "campaign", "illustration", "texture", "brand-atmosphere"] },
    "unknown": { "type": "object", "additionalProperties": false, "required": ["id", "question", "impact"], "properties": { "id": { "type": "string" }, "question": { "type": "string", "minLength": 1 }, "impact": { "enum": ["blocking", "material", "minor"] }, "recommendedAction": { "type": "string" }, "references": { "type": "array", "items": { "type": "string" }, "uniqueItems": true } } }
  }
}
