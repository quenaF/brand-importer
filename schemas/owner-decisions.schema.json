{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brand-importer.dev/schemas/owner-decisions.schema.json",
  "title": "Session-Bound Brand Owner Decisions",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisionVersion", "sessionId", "sourceImportId", "status", "decidedAt", "decidedBy", "decisions", "retention"],
  "properties": {
    "decisionVersion": { "const": "1.0.0" },
    "sessionId": { "type": "string", "minLength": 1 },
    "sourceImportId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["in-progress", "confirmed", "confirmed-with-corrections"] },
    "decidedAt": { "type": "string", "format": "date-time" },
    "decidedBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "role": { "enum": ["owner", "authorized-representative", "developer", "reviewer"] },
        "contact": { "type": "string" }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "persistedByImporter"],
      "properties": {
        "scope": { "const": "current-session-and-export-bundle" },
        "persistedByImporter": { "const": false }
      }
    },
    "decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" }, "uniqueItems": true }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subjectType", "subjectId", "action", "sourceFingerprint", "recordedAt"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" },
        "subjectType": { "enum": ["color", "typography", "logo", "imagery", "experience-signals", "voice", "unknown"] },
        "subjectId": { "type": "string", "minLength": 1 },
        "action": { "enum": ["confirm", "correct", "approve", "reject", "hold", "deprioritize", "leave-unresolved"] },
        "correctedValue": {},
        "approvedRoles": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "rightsConfirmation": { "enum": ["not-applicable", "confirmed", "not-confirmed", "restricted"] },
        "notes": { "type": "string" },
        "sourceFingerprint": { "type": "string", "minLength": 1 },
        "recordedAt": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        { "if": { "properties": { "action": { "const": "correct" } } }, "then": { "required": ["correctedValue"] } },
        { "if": { "properties": { "subjectType": { "const": "imagery" }, "action": { "const": "approve" } } }, "then": { "required": ["rightsConfirmation"] } }
      ]
    }
  }
}
