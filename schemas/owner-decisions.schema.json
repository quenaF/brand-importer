{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brand-importer.dev/schemas/owner-decisions.schema.json",
  "title": "Brand Importer Owner Decisions",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisionVersion", "organizationId", "sourceImportId", "status", "decidedAt", "decidedBy", "decisions"],
  "properties": {
    "decisionVersion": { "const": "1.0.0" },
    "organizationId": { "type": "string", "minLength": 1 },
    "sourceImportId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["in-progress", "confirmed", "confirmed-with-corrections"] },
    "decidedAt": { "type": "string", "format": "date-time" },
    "decidedBy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "role": { "enum": ["owner", "authorized-representative", "developer", "reviewer"] },
        "contact": { "type": "string" }
      }
    },
    "decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/decision" },
      "uniqueItems": true
    },
    "invalidations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decisionId", "reason", "detectedAt"],
        "properties": {
          "decisionId": { "type": "string" },
          "reason": { "enum": ["source-changed", "candidate-removed", "material-content-change", "manual-reset"] },
          "detectedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "subjectType", "subjectId", "action", "sourceFingerprint", "recordedAt"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9._:-]+$" },
        "subjectType": { "enum": ["color", "typography", "logo", "imagery", "experience-dna", "voice", "unknown"] },
        "subjectId": { "type": "string", "minLength": 1 },
        "action": { "enum": ["confirm", "correct", "approve", "reject", "hold", "deprioritize", "leave-unresolved"] },
        "correctedValue": {},
        "approvedRoles": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "notes": { "type": "string" },
        "sourceFingerprint": { "type": "string", "minLength": 1 },
        "recordedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
